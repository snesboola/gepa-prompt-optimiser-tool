# Copy to .env (already gitignored) and fill in. gepa-opt loads this
# automatically via python-dotenv, so GEMINI_API_KEY etc. don't need to be
# exported in your shell.

# Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed if you point task_lm/reflection_lm/judge_lm at an anthropic/... model
# ANTHROPIC_API_KEY=
